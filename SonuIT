            padding: 80px 5%;
        }
        .stats-grid {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .stat-item { text-align: center; }
        .stat-number {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.5rem;
            font-weight: 900;
            color: var(--gold);
            margin-bottom: 5px;
        }
        .stat-text {
            color: #fff;
            font-size: 1.1rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* --- Contact Section --- */
        .contact { background-color: var(--primary-bg); }
        .contact-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            background: var(--secondary-bg);
            border-radius: 20px;
            padding: 50px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            border: 1px solid rgba(255,255,255,0.05);
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        }
        .contact-info { flex: 1; min-width: 300px; }
        .contact-info h3 { font-size: 2rem; margin-bottom: 20px; color: var(--gold); }
        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }
        .info-icon {
            width: 50px; height: 50px;
            background: rgba(230, 184, 0, 0.1);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: var(--gold);
            font-size: 1.5rem;
        }
        .info-text h4 { color: #fff; font-size: 1.1rem; }
        .info-text p { color: var(--text-gray); font-size: 1rem; }
        
        .contact-action { flex: 1; min-width: 300px; text-align: center; }
        .call-btn {
            display: inline-block;
            background: transparent;
            border: 2px solid var(--gold);
            color: var(--gold);
            padding: 15px 40px;
            font-size: 1.5rem;
            font-weight: 700;
            border-radius: 50px;
